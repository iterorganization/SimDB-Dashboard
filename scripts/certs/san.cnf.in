# OpenSSL configuration for the SimDB dashboard TLS build.
# Generated from san.cnf.in by scripts/certs/Makefile: the subject CN /
# primary DNS SAN and the secondary DNS name are substituted at build time;
# the localhost + loopback SANs below are static.
[req]
distinguished_name = dn
req_extensions = req_ext
x509_extensions = v3_ca
prompt = no

[dn]
CN = @CERT_CN@

[req_ext]
subjectAltName = @alt_names

[v3_ca]
basicConstraints = critical,CA:TRUE
keyUsage = critical,keyCertSign,cRLSign
subjectKeyIdentifier = hash

[v3_req]
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature,keyEncipherment
extendedKeyUsage = serverAuth
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
subjectAltName = @alt_names

[alt_names]
DNS.1 = @CERT_CN@
DNS.2 = @DOMAIN_NAME@
DNS.3 = localhost
IP.1  = 127.0.0.1
IP.2  = 0:0:0:0:0:0:0:1
